% hlpl.sty v1.0 — HLPL Journal
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{hlpl}[2026/11/11 HLPL journal style v1.0]
\RequirePackage[T1]{fontenc}
\RequirePackage{lmodern}
\RequirePackage[english]{babel}
\RequirePackage{microtype}
\RequirePackage[a4paper,left=18mm,right=18mm,top=18mm,bottom=22mm,headheight=0mm,headsep=0mm,columnsep=8mm]{geometry}
\RequirePackage{xcolor}
\IfFileExists{cuted.sty}{\RequirePackage{cuted}}{\newenvironment{strip}{\par\bigskip\noindent\begin{minipage}{\linewidth}}{\end{minipage}\par}}
\RequirePackage{url}
\RequirePackage{amssymb}
\RequirePackage{amsmath,amsthm}
\RequirePackage{enumitem}
\RequirePackage{caption}
\RequirePackage{graphicx}
\RequirePackage{booktabs}
\RequirePackage[utf8]{inputenc}
\RequirePackage{tcolorbox} 
\IfFileExists{colortbl.sty}{\RequirePackage{colortbl}}{}
\IfFileExists{everysel.sty}{\RequirePackage{ragged2e}}{\providecommand{\justifying}{}}
\IfFileExists{zi4.sty}{\RequirePackage{zi4}}{}
\IfFileExists{orcidlink.sty}{\RequirePackage{orcidlink}}{\providecommand{\orcidlink}[1]{}}
\IfFileExists{fontawesome5.sty}{\RequirePackage{fontawesome5}}{\providecommand{\faPaperPlane}{}}
\IfFileExists{academicons.sty}{\RequirePackage{academicons}}{\providecommand{\aiZenodo}{}}
\RequirePackage{titlesec}
\RequirePackage{textcase}
\IfFileExists{tocloft.sty}{\RequirePackage{tocloft}}{%
  \newlength{\cftbeforesecskip}\newlength{\cftbeforesubsecskip}\newlength{\cftparskip}\newlength{\cftsecindent}\newlength{\cftsubsecindent}%
  \newcommand{\cftsecfont}{}\newcommand{\cftsecpagefont}{}\newcommand{\cftsubsecfont}{}\newcommand{\cftsubsecpagefont}{}%
}
\RequirePackage{tikz}
\RequirePackage{fancyhdr}
\RequirePackage{etoolbox}
\RequirePackage[numbers,square,sort&compress]{natbib}
\@ifpackageloaded{hyperref}{}{\PassOptionsToPackage{hidelinks}{hyperref}\RequirePackage{hyperref}}
\urlstyle{same}
\definecolor{primary}{HTML}{2C3E50}
\definecolor{subtitlegrey}{HTML}{4A4A4A}
\definecolor{lightbg}{HTML}{FDFEFF}
\definecolor{x3}{HTML}{2C3E50}
\definecolor{hlplblue}{HTML}{2C3E50}
\definecolor{hlplgrey}{HTML}{4A4A4A}
\definecolor{hlplrule}{HTML}{D9DEE5}
\setlength{\bibsep}{4pt}
\newcommand{\hlpl@journal}{Human Life Programming Language}
\newcommand{\hlpl@tagline}{An overlay journal for the Physics of Meaning}
\newcommand{\hlpl@site}{journal.hlpl.net}
\newcommand{\hlpl@volume}{Vol.~1}
\newcommand{\hlpl@issue}{No.~1}
\newcommand{\hlpl@year}{2026}
\newcommand{\hlpl@doi}{}
\newcommand{\hlpl@logo}{hlpl-logo.png}
\newcommand{\journalvolume}[1]{\renewcommand{\hlpl@volume}{#1}}
\newcommand{\journalissue}[1]{\renewcommand{\hlpl@issue}{#1}}
\newcommand{\journalyear}[1]{\renewcommand{\hlpl@year}{#1}}
\newcommand{\articledoi}[1]{\renewcommand{\hlpl@doi}{#1}}
\newcommand{\journallogo}[1]{\renewcommand{\hlpl@logo}{#1}}
\newcommand{\hlpl@logosize}{13mm}
\newcommand{\setlogosize}[1]{\renewcommand{\hlpl@logosize}{#1}}
\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\fancyfoot[C]{\sffamily\scriptsize\color{hlplgrey}\thepage}
\fancypagestyle{firstpage}{\fancyhf{}\renewcommand{\headrulewidth}{0pt}\fancyfoot[C]{\sffamily\scriptsize\color{hlplgrey}\thepage}}
\titleformat{\section}{\color{x3}\large\bfseries}{}{0em}{}
\titleformat{\subsection}{\color{x3}\normalsize\bfseries}{}{0em}{}
\titleformat{\subsubsection}{\color{x3}\small\bfseries}{}{0em}{}
\newcommand{\doi}[1]{\href{https://doi.org/#1}{doi:\nolinkurl{#1}}}
\newcommand{\notemarker}[1]{\makebox[1.2em][r]{\scriptsize\textsuperscript{#1}}}
\newcommand{\zenodo}[1]{\textcolor{gray!60}{\aiZenodo}\ \nolinkurl{#1}}
\newcommand{\submittedto}[1]{%
\tikz[baseline=-0.7ex]\node[fill=none, draw=none, rounded corners=3pt, inner sep=3pt, font=\sffamily\scriptsize, text=gray!50]{\faPaperPlane\ #1};%
}
\setlist[itemize]{noitemsep, topsep=2pt, parsep=1pt, leftmargin=*}
\makeatletter
\@ifundefined{@cftmaketoctitle}{}{\renewcommand{\@cftmaketoctitle}{}}
\renewcommand{\@maketitle}{%
  \noindent%
  \begin{minipage}[c]{0.68\textwidth}%
    \raggedright
    {\sffamily\bfseries\color{primary}\LARGE\@title\par}%
    \vspace{3mm}%
    {\@author\par}%
  \end{minipage}%
  \hfill%
  \begin{minipage}[c]{0.30\textwidth}%
    \raggedleft%
    \begin{minipage}[c]{78pt}%
      \centering%
      \includegraphics[height=\hlpl@logosize]{\hlpl@logo}\\[-0.2mm]%
      {\sffamily\itshape\color{hlplblue}\fontsize{5.5}{8}\selectfont Human Life Programming\\ Language\par}%
    \end{minipage}%
  \end{minipage}\par%
  \vspace{2mm}%
  \noindent{\footnotesize\sffamily\color{black!70}\@date\par}%
  \vspace{-2mm}%
  \noindent\textcolor{gray!30}{\rule{\linewidth}{0.3pt}}\par%
}
\newcommand{\hlplmaketitle}{\@maketitle\thispagestyle{firstpage}}
\makeatother
\newtheoremstyle{customdef}
  {\topsep}{\topsep}{\normalfont}{0pt}{\color{x3}\bfseries\small\ttfamily}{.}{5pt plus 1pt minus 1pt}{}
\theoremstyle{customdef}
\newtheorem{definition}{Definition}[section]
\newtheorem{theorem}{Theorem}[section]
\hypersetup{colorlinks=true,linkcolor=primary,citecolor=primary,urlcolor=primary}
